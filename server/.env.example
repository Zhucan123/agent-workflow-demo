# Copy to .env and fill in real values (server/.env is gitignored).
# LLM provider: auto (try openai when OPENAI_API_KEY set) | openai | stub
AGENT_LLM_MODE=auto
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Embedding backend for RAG: hash (zero-key, offline) | openai (semantic)
AGENT_EMBED_BACKEND=hash
AGENT_EMBED_MODEL=text-embedding-3-small

# Agent loop
AGENT_MODEL=gpt-4o-mini
AGENT_TIMEOUT_S=120
AGENT_STEP_DELAY_S=0.8
AGENT_APPROVAL_TIMEOUT_S=900

# MCP: off | demo (bundled external workspace) | stdio:<command>
AGENT_MCP_MODE=off
AGENT_MCP_TIMEOUT_S=60